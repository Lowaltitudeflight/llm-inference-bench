# ===== 引擎接入点 =====
# vLLM（OpenAI 兼容 server）
VLLM_BASE_URL=http://localhost:8000
VLLM_MODEL=Qwen2.5-72B-Instruct
VLLM_API_KEY=EMPTY
# 量化等级标注：fp16 / int8 / awq / gptq / unknown
VLLM_QUANT=fp16

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_API_KEY=ollama
# Ollama 的 GGUF 量化等级：q4_K_M / q5_K_M / q8_0
OLLAMA_QUANT=q4_K_M

# ===== 压测参数 =====
# 并发梯度，逗号分隔
BENCH_CONCURRENCY_LEVELS=1,2,4,8,16,32
BENCH_MAX_TOKENS=256
BENCH_TIMEOUT=120
BENCH_TEMPERATURE=0
# 流式请求（TTFT / TPOT 需要流式才能测准）
BENCH_STREAM=true
# 每档位预热请求数，不计入统计
BENCH_WARMUP=2

# ===== GPU 监控 =====
MONITOR_ENABLED=true
MONITOR_INTERVAL=0.5

# ===== API 服务 =====
API_HOST=0.0.0.0
API_PORT=8080

# ===== 日志 =====
LOG_LEVEL=INFO
